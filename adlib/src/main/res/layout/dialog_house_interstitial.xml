<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121826"
    android:padding="20dp">

    <!-- Top Bar with Ad Badge and Countdown/Close Button -->
    <TextView
        android:id="@+id/tvHouseAdBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#FF9800"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="SPONSORED"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHouseCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="Reward in 5s"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/ivHouseClose"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="8dp" />

    <ImageView
        android:id="@+id/ivHouseClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF"
        android:contentDescription="Close" />

    <!-- Center Card / Media -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvHouseMedia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/ivHouseAdIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivHouseClose">

        <ImageView
            android:id="@+id/ivHouseMediaImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1E293B"
            android:scaleType="centerCrop"
            android:src="@drawable/ads_icon"
            android:contentDescription="Ad Media" />
    </androidx.cardview.widget.CardView>

    <!-- Bottom App Info & CTA -->
    <ImageView
        android:id="@+id/ivHouseAdIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ads_icon"
        app:layout_constraintBottom_toTopOf="@id/tvHouseAdDesc"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="App Icon" />

    <TextView
        android:id="@+id/tvHouseAdTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Smart Booster &amp; Cleaner Pro"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivHouseAdIcon"
        app:layout_constraintTop_toTopOf="@id/ivHouseAdIcon" />

    <TextView
        android:id="@+id/tvHouseAdRating"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:text="★ 4.9 • Free • 10M+ Downloads"
        android:textColor="#FBBF24"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivHouseAdIcon"
        app:layout_constraintTop_toBottomOf="@id/tvHouseAdTitle" />

    <TextView
        android:id="@+id/tvHouseAdDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Boost performance, clean junk files, and keep your Android device running fast."
        android:textColor="#94A3B8"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/btnHouseAdCta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHouseAdCta"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#3B82F6"
        android:text="Install Now"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="26dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
