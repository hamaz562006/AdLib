<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_loading_dialog_card"
    android:padding="@dimen/_24sdp"
    android:elevation="@dimen/_8sdp"
    android:minWidth="200dp"
    android:maxWidth="240dp"
    app:layout_constraintWidth_percent="0.6"
    app:layout_constraintWidth_min="200dp"
    app:layout_constraintWidth_max="240dp">

    <ImageView
        android:id="@+id/anim_loading"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_100sdp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/loading_ads"
        android:src="@drawable/ic_ad_loading_megaphone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/loading_dialog_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/loading_dialog_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:gravity="center"
        android:text="@string/loading_ads"
        android:textColor="#000000"
        android:alpha="0.7"
        android:textSize="@dimen/_12ssp"
        app:layout_constraintTop_toBottomOf="@id/anim_loading"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
