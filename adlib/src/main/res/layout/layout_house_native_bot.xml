<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/houseNativeRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_border_native"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ivHouseNativeIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ads_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Icon" />

    <TextView
        android:id="@+id/tvHouseNativeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="#FF9800"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        android:text="AD"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/ivHouseNativeIcon"
        app:layout_constraintTop_toTopOf="@id/ivHouseNativeIcon" />

    <TextView
        android:id="@+id/tvHouseNativeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Featured App Recommendation"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvHouseNativeBadge"
        app:layout_constraintEnd_toStartOf="@id/btnHouseNativeCta"
        app:layout_constraintStart_toEndOf="@id/tvHouseNativeBadge"
        app:layout_constraintTop_toTopOf="@id/tvHouseNativeBadge" />

    <TextView
        android:id="@+id/tvHouseNativeDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="High performance toolkit for everyday tasks."
        android:textColor="#757575"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/ivHouseNativeIcon"
        app:layout_constraintEnd_toStartOf="@id/btnHouseNativeCta"
        app:layout_constraintStart_toEndOf="@id/ivHouseNativeIcon"
        app:layout_constraintTop_toBottomOf="@id/tvHouseNativeTitle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHouseNativeCta"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:backgroundTint="#2563EB"
        android:text="Install"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:cornerRadius="19dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
