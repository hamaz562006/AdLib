<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AdsAppTheme" parent="@style/Theme.AppCompat.Light">
    </style>
    <style name="AppTheme.Ads" parent="@style/AdsAppTheme">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:background">@drawable/ads_icon</item>
        <item name="android:paddingLeft">3dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">15px</item>
        <item name="android:minHeight">15px</item>
        <item name="android:text">Ad</item>
    </style>
    <style name="DialogAnimation" parent="">
        <item name="android:windowEnterAnimation">@anim/anim_dialog_show</item>
        <item name="android:windowExitAnimation">@anim/anim_dialog_hide</item>
    </style>
    <style name="ActivityAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/enter_zoom_out</item>
        <item name="android:activityOpenExitAnimation">@anim/exit_zoom_in</item>
        <item name="android:activityCloseEnterAnimation">@anim/enter_zoom_out1</item>
        <item name="android:activityCloseExitAnimation">@anim/exit_zoom_in</item>
    </style>
</resources>