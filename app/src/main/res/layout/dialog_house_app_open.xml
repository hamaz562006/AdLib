<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvHouseAoaBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#FF9800"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="SPONSORED"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHouseAoaDismiss"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:text="Skip (3s)"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:cornerRadius="19dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivHouseAoaMedia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="24dp"
        android:background="@drawable/bg_demo_card"
        android:padding="24dp"
        android:scaleType="centerInside"
        android:src="@drawable/ads_icon"
        app:layout_constraintBottom_toTopOf="@id/ivHouseAoaIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnHouseAoaDismiss"
        android:contentDescription="House Open Ad" />

    <ImageView
        android:id="@+id/ivHouseAoaIcon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ads_icon"
        app:layout_constraintBottom_toTopOf="@id/tvHouseAoaDesc"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="Icon" />

    <TextView
        android:id="@+id/tvHouseAoaTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Welcome to Smart Tools"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivHouseAoaIcon"
        app:layout_constraintTop_toTopOf="@id/ivHouseAoaIcon" />

    <TextView
        android:id="@+id/tvHouseAoaRating"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:text="★ 4.9 • Top Rated App"
        android:textColor="#FBBF24"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivHouseAoaIcon"
        app:layout_constraintTop_toBottomOf="@id/tvHouseAoaTitle" />

    <TextView
        android:id="@+id/tvHouseAoaDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Experience premium utilities and ultimate productivity with zero lag."
        android:textColor="#94A3B8"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/btnHouseAoaCta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHouseAoaCta"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#3B82F6"
        android:text="Get Started Free"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="26dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
